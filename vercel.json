{
  "name": "zeroasterisk-unified-preview",
  "version": 2,
  "builds": [
    {
      "src": "config.toml",
      "use": "@vercel/static-build",
      "config": {
        "command": "hugo --gc --minify",
        "outputDirectory": "public"
      }
    }
  ],
  "functions": {
    "public/**": {
      "headers": {
        "cache-control": "s-maxage=31536000"
      }
    }
  }
}